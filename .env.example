# Root Environment Configuration Template for PrepGPT

# MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prepgpt
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Spring Boot Server Configuration
SERVER_PORT=8080

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Unified Groq AI + STT + TTS Provider Configuration (Backend Only - NEVER expose keys to frontend)
GROQ_API_KEY=your_groq_api_key_here
GROQ_AI_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Resilience4j Circuit Breaker & Retry Configuration
RESILIENCE_CB_SLIDING_WINDOW_SIZE=10
RESILIENCE_CB_MIN_CALLS=5
RESILIENCE_CB_FAILURE_RATE_THRESHOLD=50
RESILIENCE_CB_WAIT_DURATION_OPEN=30s
RESILIENCE_CB_HALF_OPEN_CALLS=2
RESILIENCE_RETRY_MAX_ATTEMPTS=3
RESILIENCE_RETRY_WAIT_DURATION=1000ms

# DB-Backed Evaluation Retry Reaper Configuration
PREPGPT_EVAL_RETRY_MAX_ATTEMPTS=3
PREPGPT_EVAL_RETRY_INITIAL_DELAY_SECONDS=60
PREPGPT_EVAL_RETRY_BACKOFF_MULTIPLIER=2.0
PREPGPT_EVAL_RETRY_CRON=0 */1 * * * *
