# ==============================================================================
# PrepGPT Backend Environment Variables Template
# Copy this file to backend/.env and update values for your environment.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prepgpt
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Database Connection Pool (HikariCP)
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# JWT Authentication
# Must be at least 256 bits (32 bytes) hex or base64 encoded secret
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Groq Unified AI, Speech-to-Text (STT), and Text-to-Speech (TTS)
GROQ_API_KEY=your_groq_api_key_here
GROQ_AI_MODEL=openai/gpt-oss-120b
GROQ_AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_BASE_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_BASE_URL=https://api.groq.com/openai/v1/audio/speech
VOICE_PROVIDER=groq

# File Upload Storage
RESUME_UPLOAD_DIR=uploads/resumes

# Security & CORS
RATE_LIMIT_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
